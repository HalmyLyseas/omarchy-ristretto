#!/usr/bin/env bash
set -uo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
PLUGIN_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
LINT_BIN="${RISTRETTO_QMLLINT_BIN:-$(command -v qmllint || command -v /usr/lib/qt6/bin/qmllint || true)}"
if [[ -z "$LINT_BIN" ]]; then
  echo 'qmllint not found' >&2
  exit 1
fi
IMPORT_ROOT="$(mktemp -d)"
trap 'rm -rf "$IMPORT_ROOT"' EXIT
ln -s /usr/share/omarchy/shell "$IMPORT_ROOT/qs"
status=0
count=0
while IFS= read -r -d '' file; do
  count=$((count + 1))
  out="$("$LINT_BIN" -I "$IMPORT_ROOT" -I /usr/share/omarchy/shell "$PLUGIN_DIR/$file" 2>&1)"
  code=$?
  if [[ "$code" -ne 0 ]] || grep -q ':[0-9]*:[0-9]*: Error' <<<"$out"; then
    echo "qmllint failed for $file (exit $code)"
    echo "$out"
    status=1
  fi
done < <(git -C "$PLUGIN_DIR" ls-files --cached --others --exclude-standard -z '*.qml')
echo "qmllint checked $count files"
[[ "$count" -ge 5 ]] || { echo 'expected at least 5 QML files' >&2; exit 1; }
exit "$status"
