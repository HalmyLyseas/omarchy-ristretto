#!/usr/bin/env bash
# Runs pure logic, host contracts, writer tests, source checks, and real QML
# probes. Node, Python, Quickshell, and the host QML tree are required for
# the complete suite; every failure propagates to the final exit status.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
overall=0

echo "== JavaScript unit tests =="
node --test "$SCRIPT_DIR"/*.test.js
if [[ $? -ne 0 ]]; then overall=1; fi

echo "== Idle config writer =="
python3 "$SCRIPT_DIR/idle-writer.test.py"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== host contract (node) =="
node "$SCRIPT_DIR/host-contract.mjs"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== Service.qml (qs probe) =="
bash "$SCRIPT_DIR/probe/run"
if [[ $? -ne 0 ]]; then overall=1; fi

echo
echo "== BarWidget.qml/Panel.qml (qs UI probe) =="
bash "$SCRIPT_DIR/probe/run-ui"
if [[ $? -ne 0 ]]; then overall=1; fi

for probe in "$SCRIPT_DIR"/probe/run-*; do
  [[ "$probe" == */run-ui ]] && continue
  echo "== $(basename "$probe") =="
  bash "$probe"
  if [[ $? -ne 0 ]]; then overall=1; fi
done

echo
if [[ $overall -eq 0 ]]; then
  echo "test/all: ALL SUITES PASSED"
else
  echo "test/all: FAILURES ABOVE"
fi
exit $overall
