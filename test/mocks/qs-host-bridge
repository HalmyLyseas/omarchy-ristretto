#!/usr/bin/env python3
import json
import os
import sys
import time

args = sys.argv[1:]
with open(os.environ['HOST_BRIDGE_LOG'], 'a') as log:
    log.write(json.dumps({'pid':os.getpid(), 'args':args, 'time':time.monotonic()}) + '\n')
if args[0] == 'log':
    os.execv('/usr/bin/qs', ['qs'] + args)
if len(args) != 7 or args[:2] != ['ipc', '--pid'] or args[3:5] != ['call', '--']:
    sys.exit(2)
if args[5:] == ['idle', 'status']:
    pair = dict(screensaver=60, lock=180)
    if os.environ.get('HOST_BRIDGE_CONFIG'):
        with open(os.environ['HOST_BRIDGE_CONFIG']) as config:
            pair = json.load(config)['idle']
    print(json.dumps(dict(enabled=True, stayAwake=False, stayAwakeStateLoaded=True,
                          screensaver=int(float(pair['screensaver'])), lock=int(float(pair['lock'])))))
elif args[5:] == ['lock', 'status']:
    if os.environ.get('HOST_BRIDGE_MODE') == 'unlock-pending':
        time.sleep(0.8)
    print(json.dumps(dict(locked=True, secure=True, sessionLocked=True, pending=False)))
else:
    sys.exit(2)
